# Copie este archivo como .env y complete los valores.
# Solo las variables con prefijo PUBLIC_ llegan al navegador: nunca ponga aquí claves secretas.

# Dominio definitivo del sitio (URL canónica, sitemap y Open Graph).
SITE_URL=https://gilbertcharpentier.com

# URL de la Edge Function de Supabase que recibe el formulario.
PUBLIC_CONSULTA_ENDPOINT=https://PROYECTO.supabase.co/functions/v1/solicitar-consulta
# Origen del proyecto Supabase (se agrega a connect-src de la CSP).
PUBLIC_SUPABASE_ORIGIN=https://PROYECTO.supabase.co

# Clave pública (site key) de Cloudflare Turnstile.
PUBLIC_TURNSTILE_SITE_KEY=

# Analítica sin cookies (Plausible). Déjelo vacío para desactivarla.
PUBLIC_PLAUSIBLE_DOMAIN=
