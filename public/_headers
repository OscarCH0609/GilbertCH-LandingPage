# Cabeceras de seguridad para Cloudflare Pages (también compatibles con Netlify).
# La Content-Security-Policy se genera en cada página como <meta> con hashes (security.csp en astro.config.mjs);
# aquí se agrega frame-ancestors, que solo funciona como cabecera HTTP.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
