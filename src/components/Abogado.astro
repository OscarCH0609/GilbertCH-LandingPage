---
import { Picture } from "astro:assets";
import monograma from "../assets/monograma-hero.png";
import EncabezadoSeccion from "./EncabezadoSeccion.astro";
import Icono, { type NombreIcono } from "./Icono.astro";
import { sitio } from "../config/sitio";

// PENDIENTE: fotografía profesional del abogado (proporción 4:5).
// Cuando exista, guárdela en src/assets/foto-abogado.jpg e impórtela aquí:
//   import foto from "../assets/foto-abogado.jpg";
const foto: ImageMetadata | null = null;

const valores: { icono: NombreIcono; titulo: string; texto: string }[] = [
  { icono: "award", titulo: "Esfuerzo", texto: "Dedicación constante en la preparación de cada caso." },
  { icono: "shield-check", titulo: "Honor", texto: "Ejercicio profesional ético y responsable." },
  { icono: "handshake", titulo: "Respeto por sus intereses", texto: "Sus objetivos guían cada decisión." },
  { icono: "eye", titulo: "Claridad y transparencia", texto: "Le explicamos cada paso del trabajo realizado." },
];
---

<section id="abogado" aria-labelledby="titulo-abogado" class="seccion">
  <div class="contenedor grid items-start gap-12 lg:grid-cols-[5fr_7fr] lg:gap-20">
    <figure class="aparecer relative mx-auto w-full max-w-sm lg:sticky lg:top-28">
      <div class="absolute -bottom-3 -right-3 h-full w-full rounded border border-gold-dark/60" aria-hidden="true"></div>
      <div class="relative aspect-[4/5] overflow-hidden rounded bg-surface">
        {
          foto ? (
            <Picture
              src={foto}
              alt="Fotografía de Gilbert Charpentier, abogado y notario"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              widths={[400, 640, 800]}
              sizes="(min-width: 1024px) 384px, 90vw"
              class="h-full w-full object-cover"
            />
          ) : (
            <div class="flex h-full items-center justify-center bg-[radial-gradient(circle_at_50%_40%,#1c1c1c,#0a0a0a_70%)]">
              <Picture
                src={monograma}
                alt=""
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                widths={[280, 480]}
                sizes="240px"
                class="h-auto w-3/5 mix-blend-lighten"
              />
            </div>
          )
        }
      </div>
    </figure>

    <div>
      <EncabezadoSeccion id="titulo-abogado" etiqueta={`${sitio.profesion} · Carné ${sitio.carne}`} titulo="Gilbert Charpentier" />
      <div class="aparecer prosa mt-6 space-y-5">
        <p>
          Gilbert Charpentier es abogado y notario, incorporado al Colegio de Abogados y Abogadas de Costa Rica con
          el carné {sitio.carne}. Su práctica se orienta a la defensa de los derechos de las personas en materia
          laboral, constitucional y contencioso-administrativa.
        </p>
        <p>
          Ha obtenido logros importantes defendiendo a docentes en procesos disciplinarios ante el Ministerio de
          Educación Pública y a funcionarios de otras instituciones de la administración pública, así como en
          demandas contra el Estado en defensa de derechos laborales y financieros.
        </p>
        <p class="text-sm text-text-subtle">
          Puede verificar la colegiatura en la{" "}
          <a href={sitio.verificarColegiatura} target="_blank" rel="noopener" class="enlace"
            >consulta pública de personas agremiadas del Colegio de Abogados y Abogadas</a
          >.
        </p>
      </div>

      <ul class="mt-10 grid gap-4 sm:grid-cols-2">
        {
          valores.map((valor) => (
            <li class="aparecer tarjeta flex gap-4 p-5">
              <Icono nombre={valor.icono} tamano={26} class="mt-0.5 shrink-0 text-gold" />
              <div>
                <h3 class="text-base">{valor.titulo}</h3>
                <p class="mt-1 text-[0.9375rem] leading-relaxed">{valor.texto}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
