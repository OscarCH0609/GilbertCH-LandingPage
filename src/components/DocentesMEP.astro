---
import { getCollection } from "astro:content";
import EncabezadoSeccion from "./EncabezadoSeccion.astro";
import Acordeon from "./Acordeon.astro";
import Icono, { type NombreIcono } from "./Icono.astro";
import IconoWhatsApp from "./IconoWhatsApp.astro";
import { sitio } from "../config/sitio";

const servicios: { icono: NombreIcono; titulo: string; texto: string }[] = [
  {
    icono: "shield",
    titulo: "Procesos disciplinarios y acciones correctivas",
    texto: "Defensa desde el traslado de cargos: revisión del expediente, respuesta, prueba y audiencia.",
  },
  {
    // PENDIENTE: confirmar la denominación y la sigla exactas del reglamento vigente (REAC o REA).
    icono: "book-open",
    titulo: "Reglamento de Evaluación de los Aprendizajes",
    texto: "Asesoría ante conflictos por la aplicación del reglamento de evaluación en su centro educativo.",
  },
  {
    icono: "graduation-cap",
    titulo: "Asignación de lecciones y nombramientos en propiedad",
    texto: "Reclamos por lecciones, recargos o nombramientos que no se asignaron conforme a derecho.",
  },
];

const preguntas = (await getCollection("faq", (p) => p.data.grupo === "mep")).sort(
  (a, b) => a.data.orden - b.data.orden,
);
---

<section id="docentes-mep" aria-labelledby="titulo-mep" class="seccion relative overflow-hidden border-y border-border bg-surface">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -left-48 top-1/3 size-[36rem] rounded-full bg-[radial-gradient(circle,rgb(200_152_63/0.08),transparent_65%)]"
  >
  </div>
  <div class="contenedor relative">
    <div class="grid gap-10 lg:grid-cols-[7fr_5fr] lg:items-end">
      <EncabezadoSeccion
        id="titulo-mep"
        etiqueta="Docentes y personal del MEP"
        titulo="¿Es docente o funcionario del MEP y enfrenta un proceso administrativo?"
      >
        <p>
          La defensa de docentes y personal del Ministerio de Educación Pública es el principal campo de experiencia
          del consultorio. Actuar a tiempo marca la diferencia: consulte apenas reciba una notificación.
        </p>
      </EncabezadoSeccion>
      <div class="aparecer lg:justify-self-end">
        <a
          href={sitio.whatsapp.mep}
          target="_blank"
          rel="noopener"
          class="boton boton-primario w-full sm:w-auto"
          data-evento="clic_whatsapp"
          data-origen="docentes-mep"
        >
          <IconoWhatsApp tamano={20} />
          Consultar mi caso por WhatsApp
        </a>
      </div>
    </div>

    <ul class="mt-12 grid gap-5 md:grid-cols-3">
      {
        servicios.map((s) => (
          <li class="aparecer rounded border border-border bg-bg p-7">
            <Icono nombre={s.icono} tamano={30} class="text-gold" />
            <h3 class="mt-5 text-lg">{s.titulo}</h3>
            <p class="mt-3 text-[0.9375rem] leading-relaxed">{s.texto}</p>
          </li>
        ))
      }
    </ul>

    <div class="aparecer mt-16 grid gap-8 lg:grid-cols-[4fr_8fr]">
      <div>
        <p class="etiqueta">Preguntas frecuentes</p>
        <p class="mt-3 font-serif text-3xl font-semibold text-text">Dudas comunes de docentes</p>
      </div>
      <Acordeon preguntas={preguntas} prefijo="mep" />
    </div>
  </div>
</section>
