---
import { Image } from "astro:assets";
import logo from "../assets/logo-encabezado.png";
import Icono from "./Icono.astro";
import { sitio } from "../config/sitio";

const anio = new Date().getFullYear();
---

<footer class="border-t border-border bg-bg pb-24 pt-16 text-sm text-text-subtle sm:pb-12">
  <div class="contenedor grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <Image src={logo} alt="Gilbert Charpentier, Consultorio Jurídico" widths={[200, 400]} sizes="200px" class="h-auto w-[200px]" />
      <p class="mt-5 max-w-sm">
        {sitio.profesion} · Carné profesional {sitio.carne}<br />
        <a href={sitio.mapas.google} target="_blank" rel="noopener" class="hover:text-gold-light" data-evento="clic_como_llegar" data-origen="pie">
          {sitio.direccion.linea}, {sitio.direccion.provincia}, Costa Rica
        </a>
      </p>
    </div>

    <div>
      <h2 class="etiqueta font-sans text-[length:var(--fs-label)]">Contacto</h2>
      <ul class="mt-3">
        {
          sitio.telefonos.map((t) => (
            <li>
              <a href={t.href} class="inline-flex min-h-11 items-center hover:text-gold-light" data-evento="clic_llamar">
                Tel. {t.visible}
              </a>
            </li>
          ))
        }
        <li>
          <a href={`mailto:${sitio.correo}`} class="inline-flex min-h-11 items-center break-all hover:text-gold-light">{sitio.correo}</a>
        </li>
        {
          sitio.redes.map((red) => (
            <li>
              <a href={red.url} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center hover:text-gold-light">
                {red.nombre}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="etiqueta font-sans text-[length:var(--fs-label)]">Información legal</h2>
      <ul class="mt-3">
        <li><a href="/aviso-legal" class="inline-flex min-h-11 items-center hover:text-gold-light">Aviso legal</a></li>
        <li><a href="/privacidad" class="inline-flex min-h-11 items-center hover:text-gold-light">Política de privacidad</a></li>
        <li><a href="/cookies" class="inline-flex min-h-11 items-center hover:text-gold-light">Política de cookies</a></li>
      </ul>
    </div>
  </div>

  <div class="contenedor mt-12 border-t border-border pt-8 text-xs leading-relaxed">
    <p class="max-w-3xl">
      La información de este sitio es de carácter general y no constituye asesoría legal. Solicitar una cita no
      establece una relación abogado-cliente.
    </p>
    <p class="mt-4">© {anio} {sitio.nombreCompleto}. Todos los derechos reservados.</p>
  </div>

  <!-- Créditos del desarrollador -->
  <div class="contenedor mt-10">
    <div
      class="flex flex-col gap-5 rounded border border-border bg-surface px-6 py-5 sm:flex-row sm:items-center sm:justify-between"
    >
      <div class="flex items-center gap-4">
        <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-full border border-gold-dark/60 text-gold">
          <Icono nombre="codigo" tamano={20} />
        </span>
        <div>
          <p class="etiqueta text-[0.6875rem]">Desarrollador del sitio web</p>
          <p class="mt-1 font-serif text-xl font-semibold text-text">{sitio.desarrollador.nombre}</p>
        </div>
      </div>
      <ul class="flex flex-col gap-x-6 sm:flex-row sm:items-center">
        <li>
          <a href={`mailto:${sitio.desarrollador.correo}`} class="inline-flex min-h-11 items-center gap-2 break-all hover:text-gold-light">
            <Icono nombre="mail" tamano={16} class="shrink-0 text-gold" />
            {sitio.desarrollador.correo}
          </a>
        </li>
        <li>
          <a href={sitio.desarrollador.telefono.href} class="inline-flex min-h-11 items-center gap-2 whitespace-nowrap hover:text-gold-light">
            <Icono nombre="phone" tamano={16} class="shrink-0 text-gold" />
            {sitio.desarrollador.telefono.visible}
          </a>
        </li>
      </ul>
    </div>
  </div>
</footer>
