---
// Íconos lineales de Lucide, renderizados como SVG estático (sin JavaScript en el cliente).
import {
  ArrowRight, BadgeCheck, BookOpen, Briefcase, CalendarDays, Check, ChevronDown, Clock,
  ExternalLink, FileText, GraduationCap, Handshake, Landmark, Mail, MapPin, Menu, Navigation,
  Phone, Presentation, Scale, Shield, ShieldCheck, Stamp, Users, X, Eye, Award,
} from "lucide-react";

const mapa = {
  "arrow-right": ArrowRight, "badge-check": BadgeCheck, "book-open": BookOpen, briefcase: Briefcase,
  calendar: CalendarDays, check: Check, "chevron-down": ChevronDown, clock: Clock,
  "external-link": ExternalLink, "file-text": FileText, "graduation-cap": GraduationCap,
  handshake: Handshake, landmark: Landmark, mail: Mail, "map-pin": MapPin, menu: Menu,
  navigation: Navigation, phone: Phone, presentation: Presentation, scale: Scale, shield: Shield, "shield-check": ShieldCheck,
  stamp: Stamp, users: Users, x: X, eye: Eye, award: Award,
};

export type NombreIcono = keyof typeof mapa;

interface Props {
  nombre: NombreIcono;
  tamano?: number;
  class?: string;
}

const { nombre, tamano = 24, class: clase } = Astro.props;
const Componente = mapa[nombre];
---

<Componente size={tamano} strokeWidth={1.5} className={clase} aria-hidden="true" focusable="false" />
